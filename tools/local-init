#!/usr/bin/env bash
set -e

# Get the absolute directory of the script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Get the project root (parent directory of tools/)
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
ARGOCD_CHART_DIR="$PROJECT_ROOT/platform/argocd"

CLUSTER_NAME="${CLUSTER_NAME:-platform}"

if kind get clusters | grep -qx "$CLUSTER_NAME"; then
    echo "Kind cluster: $CLUSTER_NAME already exists. Skipping creation."
else
    echo "Creating kind cluster: $CLUSTER_NAME"
    kind create cluster --config "$PROJECT_ROOT/kind-config.yaml" --name "$CLUSTER_NAME"
    kubectl config use-context "kind-$CLUSTER_NAME"
fi

echo "Installing helm repositories"
helm repo add argo https://argoproj.github.io/argo-helm --force-update
helm repo update

# Install ArgoCD for CRDs that will bootstrap the cluster
if helm status argocd --namespace argocd >/dev/null 2>&1; then
    echo "Argocd already installed. Skipping installation."
else
    echo "Building argocd chart dependencies"
    helm dependency build "$ARGOCD_CHART_DIR"

    echo "Installing argocd"
    helm install argocd "$ARGOCD_CHART_DIR" --namespace argocd --create-namespace --wait
fi

# Install the platform project and bootstrap the platform
kubectl apply -f "$PROJECT_ROOT/bootstrap/platform/root.yaml"
